.DS_Store
.vscode/
.pip-cache/
.pytest_cache/
.venv-graph/
.venv-pinned/
.uv-cache/
.uv-python/
.uv-tools/
benchmark/graph_method/data/
benchmark/graph_method/results/
__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*/*.pdf
/references/literature/*.pdf

# Disposable fixtures and development probes; curated experiments use research/runs.
/scratch/

# Research runs: readable records are versioned; expanded artifacts stay local
# and are restored from the sealed package or external storage when needed.
# One rule covers every run, so adding a run never needs an ignore exception.
/research/runs/*/**
!/research/runs/*/summary.md
!/research/runs/*/provenance.json
!/research/runs/*/command.json
!/research/runs/*/report.json

# One-time exceptions, not a per-run pattern:
# - the legacy phase-1 run keeps its readable logs and protocol as a unit;
# - the T005 controlled rerun keeps its 4.3 MB directory as reproducibility
#   evidence (D022).
!/research/runs/phase1-*/**
!/research/runs/p01-region-evolvegcnh-seed1-repeat-20261018T004254Z/**
