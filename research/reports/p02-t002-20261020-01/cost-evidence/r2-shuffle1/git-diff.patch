+def _validate_generation_records(directory, provenance):
+    """Validate recorded identities using saved JSON only, not current sources."""
+    def digest(value):
+        return (isinstance(value, str) and len(value) == 64
+                and all(character in '0123456789abcdef' for character in value))
+
+    def fail(reason):
+        raise ValueError(f'prepared generation provenance: {reason}')
+
+    generator = provenance.get('generator')
+    if not isinstance(generator, dict):
+        fail('missing generator identity')
+    hashes = generator.get('source_sha256')
+    names = ('shuffle.py', 'graph.py', 'protocol.py')
+    if not isinstance(hashes, dict) or set(hashes) != set(names):
+        fail('incomplete generator source identity')
+    source = read_json(directory / 'source.json')
+    if not isinstance(source, dict) or not isinstance(source.get('files'), dict):
+        fail('missing source identity')
+    for name in names:
+        entry = source['files'].get('benchmark/graph_value_skeleton/' + name)
+        if (not digest(hashes[name]) or not isinstance(entry, dict)
+                or entry.get('sha256') != hashes[name]):
+            fail(f'generator/source identity mismatch: {name}')
+    if not isinstance(source.get('protocol'), dict) or not digest(source['protocol'].get('sha256')):
+        fail('missing scientific protocol identity')
+    environment = read_json(directory / 'environment.json')
+    if not isinstance(environment, dict) or not isinstance(environment.get('packages'), dict):
+        fail('missing environment identity')
+    python_version = generator.get('python')
+    if (not isinstance(python_version, list) or len(python_version) != 3
+            or any(type(value) is not int or value < 0 for value in python_version)
+            or environment.get('python_version_info') != python_version):
+        fail('generator/environment Python identity mismatch')
+    for name in ('numpy', 'pandas', 'pyarrow'):
+        version = generator.get(name)
+        if (not isinstance(version, str) or not version.strip()
+                or environment['packages'].get(name) != version):
+            fail(f'generator/environment package identity mismatch: {name}')
+
